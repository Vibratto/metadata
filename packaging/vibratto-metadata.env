# Vibratto Metadata settings. Restart the service after editing:
#   sudo systemctl restart vibratto-metadata
#
# DJANGO_SECRET_KEY and VIBRATTO_SETUP_CODE are generated on install and appended below.
# The web interface asks for the setup code to create the account.
DJANGO_SETTINGS_MODULE=config.settings.base

# Names and addresses the application answers to. The host name and its IPs are added on
# install; add your domain here if you use one.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database and, unless you set an absolute download folder in Settings, the music.
VIBRATTO_DATA_DIR=/var/lib/vibratto-metadata
VIBRATTO_FRONTEND_DIR=/opt/vibratto-metadata/frontend-dist

# The application serves the interface and the API on a single port. Use 127.0.0.1:8000
# to keep it local, behind a reverse proxy on the same machine.
VIBRATTO_BIND=0.0.0.0:8000

# Plain HTTP access. Behind an HTTPS reverse proxy, delete this line and enable the next two.
DJANGO_ALLOW_INSECURE_HTTP=1
# DJANGO_TRUST_PROXY_SSL_HEADER=1
# DJANGO_AXES_TRUST_FORWARDED_FOR=1
