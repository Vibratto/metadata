[Unit]
Description=Vibratto Metadata
After=network-online.target
Wants=network-online.target

[Service]
User=vibratto-metadata
WorkingDirectory=/var/lib/vibratto-metadata
EnvironmentFile=/etc/vibratto-metadata/vibratto-metadata.env
# A single worker: background jobs run inside the process.
ExecStart=/opt/vibratto-metadata/venv/bin/gunicorn --chdir /opt/vibratto-metadata/backend config.wsgi:application --workers 1 --threads 8 --bind ${VIBRATTO_BIND}
Restart=on-failure

# Sandboxing. The music folder is the user's choice (it may live in /home, /srv or /mnt), so
# ProtectSystem=strict and ProtectHome are not used: /usr, /boot and /etc are read-only and
# the code in /opt belongs to root.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0022

[Install]
WantedBy=multi-user.target
