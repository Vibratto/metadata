# Development settings: copy this file to .env and adjust it.

# Required outside development.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the database lives, and the music unless the download folder is absolute.
# Defaults to the backend folder.
# VIBRATTO_DATA_DIR=/var/lib/vibratto-metadata

# One-time code the first screen asks for to create the account. Empty: no code is asked.
# VIBRATTO_SETUP_CODE=

# Plain HTTP on a trusted network (no Secure cookies, no HTTPS redirect).
# DJANGO_ALLOW_INSECURE_HTTP=1

# Behind a reverse proxy.
# DJANGO_TRUST_PROXY_SSL_HEADER=1    # trust X-Forwarded-Proto
# DJANGO_AXES_TRUST_FORWARDED_FOR=1  # lock out the client's address, not the proxy's (single proxy)
# DJANGO_SESSION_IDLE_SECONDS=1800   # the session expires after this much inactivity
